{
  "name": "nospoon",
  "version": "0.2.0",
  "description": "P2P VPN over HyperDHT - WireGuard-like interface using Hyperswarm",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "nospoon": "bin/cli.js"
  },
  "scripts": {
    "server": "node bin/cli.js server",
    "client": "node bin/cli.js client",
    "test": "node --test test/*.test.js",
    "build": "esbuild web/index.jsx --bundle --outfile=lib/web.bundle.js --format=esm --platform=browser --jsx=automatic --minify",
    "dev": "node scripts/dev-web.mjs",
    "dev:web": "vite --config web/vite.config.mjs"
  },
  "keywords": [
    "p2p",
    "vpn",
    "hyperdht",
    "holesail",
    "tun"
  ],
  "author": "Vaios K",
  "license": "GPL-3.0-only",
  "files": [
    "bin/",
    "lib/index.js",
    "lib/client.js",
    "lib/dht-connect.js",
    "lib/direct-pool.js",
    "lib/framing.js",
    "lib/hub-directory.js",
    "lib/ip-subnet.js",
    "lib/key-encoding.js",
    "lib/key-address.js",
    "lib/full-tunnel.js",
    "lib/full-tunnel-linux.js",
    "lib/full-tunnel-darwin.js",
    "lib/routing-policy.js",
    "lib/routing.js",
    "lib/shared-swarm-inbound.js",
    "lib/server.js",
    "lib/mesh-identifier.js",
    "lib/mesh-ip-reservations.js",
    "lib/control-http.js",
    "lib/dns-server.js",
    "lib/dns-mesh-name.js",
    "lib/dns-manual-registry.js",
    "lib/dns-loopback-aliases.js",
    "lib/web.bundle.js",
    "lib/web.bundle.css",
    "lib/swarm-mesh.js",
    "lib/swarm-topic.js",
    "lib/tun.js",
    "lib/tun-linux.js",
    "lib/tun-darwin.js",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "dependencies": {
    "dns-packet": "^5.6.1",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.1",
    "hyperswarm": "^4.17.0",
    "koffi": "^2.15.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "vite": "^6.0.0"
  }
}
