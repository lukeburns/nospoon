{
  "name": "nospoon",
  "version": "0.2.0",
  "description": "P2P VPN over HyperDHT - WireGuard-like interface using Hyperswarm",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./examples/spoon-hello/server": "./examples/spoon-hello/server.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "nospoon": "bin/cli.js"
  },
  "scripts": {
    "server": "node bin/cli.js server",
    "client": "node bin/cli.js client",
    "test": "node --test test/*.test.js",
    "build": "esbuild web/index.jsx --bundle --outfile=lib/web.bundle.js --format=esm --platform=browser --jsx=automatic --minify && esbuild web/browser-net-shim.js --bundle --outfile=lib/browser-net-shim.bundle.js --format=esm --platform=browser --minify && node scripts/copy-v86-assets.js",
    "build:examples": "npm run build:simple && npm run build:spoon-hello",
    "build:spoon-hello": "npm install --prefix examples/spoon-hello && npm run build --prefix examples/spoon-hello",
    "build:simple": "npm install --prefix examples/simple && npm run build --prefix examples/simple",
    "postinstall": "node scripts/copy-v86-assets.js",
    "fetch-freebsd-disk": "node scripts/copy-v86-assets.js --freebsd-disk",
    "dev": "node scripts/dev-web.mjs",
    "dev:web": "vite --config web/vite.config.mjs"
  },
  "keywords": [
    "p2p",
    "vpn",
    "hyperdht",
    "holesail",
    "tun"
  ],
  "author": "Vaios K",
  "license": "GPL-3.0-only",
  "files": [
    "bin/",
    "lib/index.js",
    "lib/client.js",
    "lib/dht-connect.js",
    "lib/direct-pool.js",
    "lib/framing.js",
    "lib/hub-directory.js",
    "lib/ip-subnet.js",
    "lib/key-encoding.js",
    "lib/key-address.js",
    "lib/full-tunnel.js",
    "lib/full-tunnel-linux.js",
    "lib/full-tunnel-darwin.js",
    "lib/routing-policy.js",
    "lib/routing.js",
    "lib/shared-swarm-inbound.js",
    "lib/server.js",
    "lib/mesh-identifier.js",
    "lib/nospoon-identity.js",
    "lib/mesh-ip-reservations.js",
    "lib/control-http.js",
    "lib/dns-server.js",
    "lib/dns-mesh-name.js",
    "lib/dns-manual-registry.js",
    "lib/dns-loopback-aliases.js",
    "lib/whois-auth-proxy.js",
    "lib/ipfs-cid-dns.js",
    "lib/ipfs-dweb-http.js",
    "lib/ipfs-resolve-content.js",
    "lib/ipfs-helia-worker-entry.js",
    "lib/ipfs-helia-worker-bridge.js",
    "lib/browser-net-proxy.js",
    "lib/browser-net-tcp.js",
    "web/net/lib/browser-net-middleware.js",
    "web/net/lib/tcp-ipv4.js",
    "web/net/package.json",
    "examples/spoon-hello/package.json",
    "examples/spoon-hello/server.js",
    "examples/spoon-hello/scripts/build.mjs",
    "examples/spoon-hello/scripts/dev.mjs",
    "examples/spoon-hello/dist/index.html",
    "examples/spoon-hello/dist/main.js",
    "examples/simple/package.json",
    "examples/simple/scripts/build.mjs",
    "examples/simple/web/app.js",
    "examples/simple/dist/index.html",
    "lib/browser-net-shim.bundle.js",
    "lib/v86/libv86.mjs",
    "lib/v86/v86.wasm",
    "lib/v86/hello-demo.mjs",
    "lib/v86/guest/seabios.bin",
    "lib/v86/guest/vgabios.bin",
    "lib/web.bundle.js",
    "lib/web.bundle.css",
    "lib/swarm-mesh.js",
    "lib/swarm-topic.js",
    "lib/tun.js",
    "lib/tun-linux.js",
    "lib/tun-darwin.js",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "dependencies": {
    "@helia/unixfs": "^6.0.4",
    "blockstore-fs": "^2.0.5",
    "busboy": "^1.6.0",
    "datastore-fs": "^11.0.2",
    "dns-packet": "^5.6.1",
    "helia": "^6.0.22",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.1",
    "hyperswarm": "^4.17.0",
    "koffi": "^2.15.2",
    "multiformats": "^13.4.2",
    "undici": "^7.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "v86": "^0.5.319",
    "ws": "^8.20.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "vite": "^6.0.0"
  }
}
