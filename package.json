{
  "name": "nospoon",
  "version": "0.2.0",
  "description": "P2P VPN over HyperDHT - WireGuard-like interface using Hyperswarm",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./lib/control/*": "./lib/control/*.js",
    "./lib/dns/*": "./lib/dns/*.js",
    "./lib/identity/*": "./lib/identity/*.js",
    "./lib/ip/*": "./lib/ip/*.js",
    "./lib/mesh/*": "./lib/mesh/*.js",
    "./lib/route/*": "./lib/route/*.js",
    "./lib/tun/*": "./lib/tun/*.js",
    "./lib/wire/*": "./lib/wire/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "nospoon": "bin/cli.js"
  },
  "scripts": {
    "server": "node bin/cli.js server",
    "client": "node bin/cli.js client",
    "test": "node --test test/*.test.js",
    "build": "esbuild web/index.jsx --bundle --outfile=lib/web.bundle.js --format=esm --platform=browser --jsx=automatic --minify",
    "dev": "node scripts/dev-web.mjs",
    "dev:web": "vite --config web/vite.config.mjs"
  },
  "keywords": [
    "p2p",
    "vpn",
    "hyperdht",
    "holesail",
    "tun"
  ],
  "author": "Vaios K",
  "license": "GPL-3.0-only",
  "files": [
    "bin/",
    "lib/index.js",
    "lib/web.bundle.js",
    "lib/web.bundle.css",
    "lib/control/**/*.js",
    "lib/dns/**/*.js",
    "lib/identity/**/*.js",
    "lib/ip/**/*.js",
    "lib/mesh/**/*.js",
    "lib/route/**/*.js",
    "lib/tun/**/*.js",
    "lib/wire/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "dependencies": {
    "dns-packet": "^5.6.1",
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.1",
    "hyperswarm": "^4.17.0",
    "koffi": "^2.15.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "ws": "^8.20.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.25.12",
    "vite": "^6.0.0"
  }
}
