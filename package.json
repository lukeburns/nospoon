{
  "name": "nospoon",
  "version": "0.2.0",
  "description": "P2P VPN over HyperDHT - WireGuard-like interface using Hyperswarm",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./lib/*": "./lib/*.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "nospoon": "bin/cli.js"
  },
  "scripts": {
    "server": "node bin/cli.js server",
    "client": "node bin/cli.js client",
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "p2p",
    "vpn",
    "hyperdht",
    "holesail",
    "tun"
  ],
  "author": "Vaios K",
  "license": "GPL-3.0-only",
  "files": [
    "bin/",
    "lib/index.js",
    "lib/client.js",
    "lib/framing.js",
    "lib/hub-directory.js",
    "lib/ip-subnet.js",
    "lib/key-encoding.js",
    "lib/key-address.js",
    "lib/full-tunnel.js",
    "lib/full-tunnel-linux.js",
    "lib/full-tunnel-darwin.js",
    "lib/routing.js",
    "lib/server.js",
    "lib/swarm-mesh.js",
    "lib/swarm-topic.js",
    "lib/tun.js",
    "lib/tun-linux.js",
    "lib/tun-darwin.js",
    "README.md",
    "LICENSE"
  ],
  "type": "commonjs",
  "dependencies": {
    "hypercore-crypto": "^3.6.1",
    "hyperdht": "^6.29.1",
    "hyperswarm": "^4.17.0",
    "koffi": "^2.15.2",
    "z32": "^1.1.0"
  }
}
