#!/bin/sh
# =============================================================
#  dungeon-boot.sh
#  Turns a fresh FreeBSD v86 instance into a node in the
#  peer-to-peer dungeon mesh. Run once on first boot.
# =============================================================

set -e

# ----- config ------------------------------------------------

SUBNET="10.0.0"              # adjust to your mesh subnet
SCAN_RANGE="1 254"            # IP range to scan for peers
DUNGEON_ROOT="/var/dungeon"   # the explorable world
GUESTBOOK="/var/guestbook"    # signed visitor messages
INCOMING="/var/incoming"      # mailbox for received items
PUBLIC="/var/public"          # items visitors can take
BREADCRUMB_DIR="/tmp/trail"   # ssh hop breadcrumbs
PEER_CACHE="/var/peers"       # discovered peer list
COMMANDS="/usr/local/bin"     # where game commands live

# ----- identity ----------------------------------------------

# generate host key pair if missing (this IS your identity)
if [ ! -f /root/.ssh/id_ed25519 ]; then
    mkdir -p /root/.ssh
    ssh-keygen -t ed25519 -f /root/.ssh/id_ed25519 -N "" -q
fi

MYKEY=$(cat /root/.ssh/id_ed25519.pub | awk '{print $2}')
SHORT_KEY=$(echo "$MYKEY" | head -c 16)

# allow all peers to log in as root with no friction
cp /root/.ssh/id_ed25519.pub /root/.ssh/authorized_keys
# we'll append peer keys as we discover them
chmod 600 /root/.ssh/authorized_keys

# configure ssh to skip host key checking on the mesh
cat > /root/.ssh/config <<'EOF'
Host 10.0.0.*
    User root
    StrictHostKeyChecking no
    UserKnownHostsFile /dev/null
    LogLevel ERROR
    IdentityFile /root/.ssh/id_ed25519
EOF
chmod 600 /root/.ssh/config

# ----- directory structure (the world) -----------------------

mkdir -p "$DUNGEON_ROOT"
mkdir -p "$GUESTBOOK"
mkdir -p "$INCOMING"
mkdir -p "$PUBLIC"
mkdir -p "$BREADCRUMB_DIR"
mkdir -p "$PEER_CACHE"

# default room description
cat > /etc/motd <<EOF

  ┌─────────────────────────────────────────┐
  │  You have entered the domain of         │
  │  $SHORT_KEY...                          │
  │                                         │
  │  A bare room. Stone walls. A faint hum  │
  │  of electricity. The dungeon is alive.  │
  │                                         │
  │  Type 'help' to see what you can do.    │
  └─────────────────────────────────────────┘

EOF

# welcome message for the dungeon root
cat > "$DUNGEON_ROOT/README" <<'EOF'
You stand at the entrance of this peer's dungeon.
Look around. Files are objects. Scripts are magic.
Directories are rooms. Portals lead elsewhere.

Tread carefully — or don't. They can always revert.
EOF

# ----- game commands -----------------------------------------

# --- help ---
cat > "$COMMANDS/help" <<'SCRIPT'
#!/bin/sh
cat <<'HELP'

  THE DUNGEON IS ALIVE
  ====================

  who                  - list peers on the mesh
  look [key/ip]        - read a peer's room description
  write <key/ip> <msg> - leave a signed message on their wall
  leave <key/ip> <file> - drop a file in their incoming
  take <key/ip> <file>  - grab a file from their public
  portal <key/ip> [path] - step through to another peer
  back                  - retrace your last portal hop
  map                   - show the mesh topology
  sign <message>        - create a signed note file

  CONVENTIONS
  -----------
  /etc/motd             - your room description (edit it!)
  /var/dungeon/         - your explorable world
  /var/guestbook/       - messages left by visitors
  /var/incoming/        - files others have sent you
  /var/public/          - files others can take
  
  BUILDING
  --------
  Make directories — they're rooms.
  Make scripts — they're interactive objects.
  Make a script that ssh's elsewhere — that's a portal.
  Leave READMEs — they're descriptions.
  The rest is up to you.

HELP
SCRIPT
chmod +x "$COMMANDS/help"

# --- who: discover peers on the mesh ---
cat > "$COMMANDS/who" <<'SCRIPT'
#!/bin/sh
# scan the subnet for live peers, grab their key + motd first line
SUBNET="10.0.0"
echo ""
echo "  PEERS ON THE MESH"
echo "  ================="
echo ""

for i in $(seq 1 254); do
    ip="$SUBNET.$i"
    # fast ping check
    ping -c 1 -W 1 "$ip" > /dev/null 2>&1 || continue

    # try to grab their key and motd
    key=$(ssh -o ConnectTimeout=2 "$ip" \
        "cat /root/.ssh/id_ed25519.pub 2>/dev/null" 2>/dev/null \
        | awk '{print $2}' | head -c 16)
    desc=$(ssh -o ConnectTimeout=2 "$ip" \
        "head -1 /var/dungeon/README 2>/dev/null || echo '(unexplored)'" \
        2>/dev/null)

    if [ -n "$key" ]; then
        printf "  %-16s  %s  %s\n" "$key..." "$ip" "$desc"
        # cache the peer
        echo "$ip $key" > "/var/peers/$key"
        # trust their key
        ssh -o ConnectTimeout=2 "$ip" \
            "cat /root/.ssh/id_ed25519.pub" \
            >> /root/.ssh/authorized_keys 2>/dev/null
    fi
done

# deduplicate authorized_keys
sort -u /root/.ssh/authorized_keys > /tmp/ak_dedup
mv /tmp/ak_dedup /root/.ssh/authorized_keys
chmod 600 /root/.ssh/authorized_keys

echo ""
SCRIPT
chmod +x "$COMMANDS/who"

# --- look: read a peer's room description ---
cat > "$COMMANDS/look" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ]; then
    echo ""
    cat /etc/motd
    echo ""
    echo "  NEARBY:"
    ls -F /var/dungeon/ 2>/dev/null
    echo ""
    exit 0
fi

target="$1"
# resolve short key to ip if needed
if echo "$target" | grep -qv '\.'; then
    ip=$(grep "$target" /var/peers/* 2>/dev/null | head -1 | awk '{print $1}')
    if [ -z "$ip" ]; then
        # treat as ip fragment
        ip="10.0.0.$target"
    fi
else
    ip="$target"
fi

echo ""
ssh -o ConnectTimeout=3 "$ip" "cat /etc/motd" 2>/dev/null || echo "  (unreachable)"
echo ""
SCRIPT
chmod +x "$COMMANDS/look"

# --- write: leave a signed message on a peer's guestbook ---
cat > "$COMMANDS/write" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ] || [ -z "$2" ]; then
    echo "usage: write <ip/key> <message>"
    exit 1
fi

target="$1"
shift
message="$*"
timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
mykey=$(cat /root/.ssh/id_ed25519.pub | awk '{print $2}' | head -c 16)

# resolve target
if echo "$target" | grep -qv '\.'; then
    ip=$(grep "$target" /var/peers/* 2>/dev/null | head -1 | awk '{print $1}')
    [ -z "$ip" ] && ip="10.0.0.$target"
else
    ip="$target"
fi

# create signed entry
entry="[$timestamp] $mykey: $message"
signature=$(echo "$entry" | ssh-keygen -Y sign -f /root/.ssh/id_ed25519 -n guestbook - 2>/dev/null | base64 -w0)

# deliver
echo "$entry" | ssh -o ConnectTimeout=3 "$ip" \
    "cat >> /var/guestbook/wall.txt" 2>/dev/null

if [ $? -eq 0 ]; then
    echo "  message left on ${target}'s wall."
else
    echo "  couldn't reach $target."
fi
SCRIPT
chmod +x "$COMMANDS/write"

# --- leave: drop a file in someone's incoming ---
cat > "$COMMANDS/leave" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ] || [ -z "$2" ]; then
    echo "usage: leave <ip/key> <file>"
    exit 1
fi

target="$1"
file="$2"

if [ ! -f "$file" ]; then
    echo "  no such file: $file"
    exit 1
fi

if echo "$target" | grep -qv '\.'; then
    ip=$(grep "$target" /var/peers/* 2>/dev/null | head -1 | awk '{print $1}')
    [ -z "$ip" ] && ip="10.0.0.$target"
else
    ip="$target"
fi

scp -o ConnectTimeout=3 "$file" "$ip:/var/incoming/" 2>/dev/null

if [ $? -eq 0 ]; then
    echo "  left $(basename $file) in ${target}'s incoming."
else
    echo "  couldn't reach $target."
fi
SCRIPT
chmod +x "$COMMANDS/leave"

# --- take: grab a file from someone's public ---
cat > "$COMMANDS/take" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ] || [ -z "$2" ]; then
    echo "usage: take <ip/key> <file>"
    exit 1
fi

target="$1"
file="$2"

if echo "$target" | grep -qv '\.'; then
    ip=$(grep "$target" /var/peers/* 2>/dev/null | head -1 | awk '{print $1}')
    [ -z "$ip" ] && ip="10.0.0.$target"
else
    ip="$target"
fi

scp -o ConnectTimeout=3 "$ip:/var/public/$file" "./" 2>/dev/null

if [ $? -eq 0 ]; then
    echo "  took $file from ${target}."
else
    echo "  nothing there, or can't reach $target."
fi
SCRIPT
chmod +x "$COMMANDS/take"

# --- portal: ssh into another peer's dungeon ---
cat > "$COMMANDS/portal" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ]; then
    echo "usage: portal <ip/key> [path]"
    echo "  step through to another peer's world."
    exit 1
fi

target="$1"
path="${2:-/var/dungeon}"

if echo "$target" | grep -qv '\.'; then
    ip=$(grep "$target" /var/peers/* 2>/dev/null | head -1 | awk '{print $1}')
    [ -z "$ip" ] && ip="10.0.0.$target"
else
    ip="$target"
fi

# drop a breadcrumb so we can find our way back
mkdir -p /tmp/trail
echo "$ip" >> /tmp/trail/crumbs

echo ""
echo "  The air crackles. You step through..."
echo ""

# the portal
ssh -t "$ip" "cd $path && exec \$SHELL -l"

echo ""
echo "  You have returned."
echo ""
SCRIPT
chmod +x "$COMMANDS/portal"

# --- back: retrace the last portal hop ---
cat > "$COMMANDS/back" <<'SCRIPT'
#!/bin/sh
CRUMBS="/tmp/trail/crumbs"

if [ ! -f "$CRUMBS" ] || [ ! -s "$CRUMBS" ]; then
    echo "  You are home. No breadcrumbs to follow."
    exit 0
fi

echo ""
echo "  YOUR TRAIL"
echo "  =========="
nl -ba "$CRUMBS" | while read num ip; do
    printf "  %d. %s\n" "$num" "$ip"
done
echo ""
echo "  (you are at the end of this chain)"
echo "  Use 'exit' to step back one hop."
echo ""
SCRIPT
chmod +x "$COMMANDS/back"

# --- map: show mesh topology ---
cat > "$COMMANDS/map" <<'SCRIPT'
#!/bin/sh
SUBNET="10.0.0"
echo ""
echo "  MESH MAP"
echo "  ========"
echo ""

myip=$(ifconfig | grep "$SUBNET" | awk '{print $2}' | head -1)
mykey=$(cat /root/.ssh/id_ed25519.pub | awk '{print $2}' | head -c 16)
echo "  ★ $mykey ($myip) ← you are here"
echo ""

for peerfile in /var/peers/*; do
    [ -f "$peerfile" ] || continue
    ip=$(cat "$peerfile" | awk '{print $1}')
    key=$(basename "$peerfile")

    alive="✗"
    ping -c 1 -W 1 "$ip" > /dev/null 2>&1 && alive="●"

    # check if they have portals pointing to us or others
    portals=$(ssh -o ConnectTimeout=2 "$ip" \
        "grep -rl 'ssh.*root@' /var/dungeon/ 2>/dev/null | wc -l" \
        2>/dev/null || echo "?")

    printf "  %s %-16s  %s  portals: %s\n" "$alive" "$key..." "$ip" "$portals"
done
echo ""
SCRIPT
chmod +x "$COMMANDS/map"

# --- sign: create a signed note ---
cat > "$COMMANDS/sign" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ]; then
    echo "usage: sign <message>"
    echo "  creates a signed note file in the current directory."
    exit 1
fi

message="$*"
mykey=$(cat /root/.ssh/id_ed25519.pub | awk '{print $2}' | head -c 16)
timestamp=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
filename="note_${mykey}_$(date +%s).txt"

cat > "$filename" <<EOF
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  $message
  
  — $mykey
  $timestamp
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
EOF

echo "  signed note created: $filename"
SCRIPT
chmod +x "$COMMANDS/sign"

# --- mkportal: helper to create portal scripts ---
cat > "$COMMANDS/mkportal" <<'SCRIPT'
#!/bin/sh
if [ -z "$1" ]; then
    echo "usage: mkportal <ip/key> [landing_path] [description]"
    echo "  creates a portal script in the current directory."
    exit 1
fi

target="$1"
path="${2:-/var/dungeon}"
desc="${3:-A shimmering doorway}"

if echo "$target" | grep -qv '\.'; then
    ip=$(grep "$target" /var/peers/* 2>/dev/null | head -1 | awk '{print $1}')
    [ -z "$ip" ] && ip="10.0.0.$target"
else
    ip="$target"
fi

portalfile="portal_to_$(echo $target | head -c 8)"

cat > "$portalfile" <<EOF
#!/bin/sh
# $desc
echo ""
echo "  $desc"
echo "  You step through..."
echo ""
echo "$ip" >> /tmp/trail/crumbs
ssh -t root@$ip "cd $path && exec \\\$SHELL -l"
echo ""
echo "  You have returned."
EOF

chmod +x "$portalfile"
echo "  portal created: $portalfile"
echo "  leads to $ip:$path"
SCRIPT
chmod +x "$COMMANDS/mkportal"

# ----- peer discovery daemon ---------------------------------
# runs in the background, periodically scans for new peers
# and exchanges keys

cat > "$COMMANDS/dungeon-discover" <<'SCRIPT'
#!/bin/sh
SUBNET="10.0.0"

while true; do
    for i in $(seq 1 254); do
        ip="$SUBNET.$i"
        ping -c 1 -W 1 "$ip" > /dev/null 2>&1 || continue

        # try to exchange keys
        peerkey=$(ssh -o ConnectTimeout=2 "$ip" \
            "cat /root/.ssh/id_ed25519.pub" 2>/dev/null)

        if [ -n "$peerkey" ]; then
            shortkey=$(echo "$peerkey" | awk '{print $2}' | head -c 16)
            echo "$ip" > "/var/peers/$shortkey"

            # add their key to our authorized list
            echo "$peerkey" >> /root/.ssh/authorized_keys
            sort -u /root/.ssh/authorized_keys > /tmp/ak_dedup
            mv /tmp/ak_dedup /root/.ssh/authorized_keys
            chmod 600 /root/.ssh/authorized_keys

            # send them our key too
            cat /root/.ssh/id_ed25519.pub | ssh -o ConnectTimeout=2 "$ip" \
                "cat >> /root/.ssh/authorized_keys && \
                 sort -u /root/.ssh/authorized_keys > /tmp/ak && \
                 mv /tmp/ak /root/.ssh/authorized_keys && \
                 chmod 600 /root/.ssh/authorized_keys" 2>/dev/null
        fi
    done
    sleep 60
done
SCRIPT
chmod +x "$COMMANDS/dungeon-discover"

# ----- start services ----------------------------------------

# ensure sshd is running
service sshd onestart 2>/dev/null || true

# start peer discovery in background
dungeon-discover &
echo $! > /var/run/dungeon-discover.pid

# ----- done --------------------------------------------------

echo ""
echo "  ╔═══════════════════════════════════════╗"
echo "  ║                                       ║"
echo "  ║   THE DUNGEON IS ALIVE                ║"
echo "  ║                                       ║"
echo "  ║   your key: $SHORT_KEY...  ║"
echo "  ║                                       ║"
echo "  ║   type 'help' to begin                ║"
echo "  ║   type 'who' to find others           ║"
echo "  ║   edit /etc/motd to describe your room ║"
echo "  ║   build in /var/dungeon/              ║"
echo "  ║                                       ║"
echo "  ╚═══════════════════════════════════════╝"
echo ""