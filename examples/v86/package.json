    "build:inline": "node scripts/build.mjs --inline",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "esbuild-plugins-node-modules-polyfill": "^1.8.1",
    "v86": "^0.5.319"
  },
  "engines": {
    "node": ">=20"
  }
}
