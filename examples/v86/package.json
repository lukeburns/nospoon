{
  "name": "@nospoon/v86-browser-example",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained v86 + FreeBSD + mesh TCP bridge; assets under assets/v86, copied to dist by build",
  "scripts": {
    "vendor": "node scripts/vendor-v86.mjs",
    "fetch-freebsd-disk": "node scripts/vendor-v86.mjs --freebsd-disk",
