{
  "name": "net-browser",
  "version": "1.0.0",
  "description": "Browser net shim + Node TCP middleman (WebSocket / inner IPv4 TCP)",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "shims/net.js",
  "exports": {
    ".": "./shims/net.js",
    "./net": "./shims/net.js",
    "./browser-net-client": "./lib/browser-net-client.js",
    "./browser-net-middleware": "./lib/browser-net-middleware.js",
    "./tcp-ipv4": "./lib/tcp-ipv4.js",
    "./package.json": "./package.json"
  },
  "files": [
    "shims/net.js",
    "lib/browser-net-client.js",
    "lib/browser-net-middleware.js",
    "lib/tcp-ipv4.js",
    "build.mjs",
    "test",
    "dev-harness/index.html"
  ],
  "scripts": {
    "dev": "node build.mjs",
    "build": "node build.mjs --once",
    "test": "echo \"Run npm run dev with nospoon control HTTP; open dev-harness in browser\" && exit 0"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "esbuild-plugins-node-modules-polyfill": "^1.8.1"
  },
  "dependencies": {
    "ws": "^8.20.0"
  }
}
